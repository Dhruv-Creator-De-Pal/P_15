# Copy this file to .env and fill in your own values. Never commit .env.
# API keys are optional; leave blank to run capture-only without AI analysis.

# API_KEY=your_api_key_here
# AI_MODEL_O=your_ai_model_here
# AI_MODEL_G=your_ai_model_here
# AI_MODEL_A=your_ai_model_here

# Base URL when using a local Ollama instance
# OLLAMA_URL=http://localhost:11434

# Optional AI provider keys (only what you use)
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=...
# ANTHROPIC_API_KEY=...
# HF_TOKEN=...

# Network interface to capture on
NET_INTFC=eth0

# Set to 1 to enable promiscuous mode, 0 to disable
PROMISCUOUS_MODE=1

# Confidence threshold (0-100) for threat classification
CONFIDENCE_THRESHOLD=75

# Local SQLite database path
DB_PATH=data/p15_threats.db